# =============================================================================
#  AI電話自動応答デモ — 環境変数
#  このファイルを .env にコピーして値を埋めてください。
#  .env は絶対にコミットしないでください（契約上の義務）。
# =============================================================================

# ---- サーバー ---------------------------------------------------------------
PORT=3000
# Fastify の既定は 127.0.0.1。0.0.0.0 にしないと ngrok / 別ホストから届かず
# 「呼び出し音のあと無音で切れる」症状になります。
HOST=0.0.0.0

# TwiML に埋め込む wss:// のホスト名。空にすると受信リクエストの Host ヘッダから
# 自動生成します（ngrok 無料プランでURLが毎回変わるため、通常は空のままが便利）。
# 例: PUBLIC_HOSTNAME=xxxx-xx-xx-xx-xx.ngrok-free.app
PUBLIC_HOSTNAME=

# ---- Twilio -----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
# 署名検証にのみ使用します（本プロジェクトは Twilio REST API を呼びません）。
TWILIO_AUTH_TOKEN=
# 受付用の着信番号（E.164形式）
TWILIO_PHONE_NUMBER=

# X-Twilio-Signature 検証モード:
#   off     … 検証しない
#   log     … 検証するが失敗しても通す（Stage 1 はここから始める）
#   enforce … 検証失敗を 403 で拒否する
TWILIO_SIGNATURE_MODE=log

# ---- 音声ハンドラ -----------------------------------------------------------
# echo     … 受信音声をそのまま返す（Stage 1）
# realtime … OpenAI Realtime へ中継（Stage 2 以降。現時点では未実装）
MEDIA_HANDLER=echo

# 1回の送信にまとめる媒体フレーム数。1 = 即時1:1エコー（既定・推奨）。
# 大きくすると遅延が増えます。比較実験用。
ECHO_BATCH_FRAMES=1

# N個の media ごとに mark を送り、再生バッファ深度を計測します。0 で無効。
ECHO_MARK_EVERY=25

# ---- ログ -------------------------------------------------------------------
LOG_LEVEL=info
# 通話開始後、最初のN個の media フレームの実測値（バイト長・timestamp差分）を
# ログに出します。Twilio が公式に文書化していない値を自分の環境で確定させるため。
LOG_MEDIA_FRAMES=20

# ---- OpenAI Realtime (Stage 2 以降) -----------------------------------------
OPENAI_API_KEY=

# Realtime 対応モデルのみ。gpt-audio / gpt-audio-mini は Chat Completions 用で動きません。
#   gpt-realtime          … 公式の μ-law サンプルが使用しているモデル（最も安全）
#   gpt-realtime-2.1      … 新しい。audio/pcmu 対応は要実機確認
#   gpt-realtime-mini     … 安価。開発中の反復用
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# OpenAI への接続がこの時間で確立しなければ通話を諦めます（発信者を無音で待たせない）
REALTIME_CONNECT_TIMEOUT_MS=5000

# server_vad の調整。既定の 500ms は日本語の「考えながらの間」には短すぎます。
VAD_SILENCE_MS=800
VAD_THRESHOLD=0.5
# 無音がこの時間続いたら AI 側から促します
VAD_IDLE_TIMEOUT_MS=10000

# AI の発話速度。0.25〜1.5。数字の復唱を聞き取りやすくするなら 0.9 前後を試してください
OUTPUT_SPEED=1.0

# 入力の文字起こし。認識精度は上がりません（デバッグ記録用）。別途課金されます
ENABLE_INPUT_TRANSCRIPTION=false
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# 1応答あたりの上限。復唱が途中で切れるのを防ぎつつ暴走を抑えます
MAX_OUTPUT_TOKENS=2000

# ---- 受付内容 ---------------------------------------------------------------
# 仮予約日（YYYY-MM-DD）。住人マスタとの照合はスコープ外のため、
# ここで指定した1つの日付を全通話で案内します。未設定なら本日+7日。
TENTATIVE_DATE=

# ---- Stage 5-6 で使用 -------------------------------------------------------
DATABASE_PATH=./data/demo.sqlite
